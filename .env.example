# ==========================================
# POSTGRESQL ADMINISTRATOR
# ==========================================
POSTGRES_ADMIN_USER=helphub_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_VOLUME_NAME=helphub_pgdata

# ==========================================
# IDENTITY SERVICE
# ==========================================
IDENTITY_DB_NAME=helphub_identity
IDENTITY_DB_USER=helphub_identity_app
IDENTITY_DB_PASSWORD=change_me_identity

# ==========================================
# SUPPORT SERVICE
# ==========================================
SUPPORT_DB_NAME=helphub_support
SUPPORT_DB_USER=helphub_support_app
SUPPORT_DB_PASSWORD=change_me_support

# ==========================================
# MEDIA SERVICE
# ==========================================
MEDIA_DB_NAME=helphub_media
MEDIA_DB_USER=helphub_media_app
MEDIA_DB_PASSWORD=change_me_media

# ==========================================
# MEDIA INTERNAL SERVICE AUTHENTICATION
# ==========================================
# Generate different random keys for each service.
# Never commit actual keys to Git.
# Empty keys disable internal API authentication.
MEDIA_INTERNAL_COMMUNITY_KEY=
MEDIA_INTERNAL_SUPPORT_KEY=

# ==========================================
# MEDIA RECOVERY - DEV TESTING
# ==========================================
# false: normal Private Upload
# true : simulate crash after Cloudinary upload
# Only active when the dev fault injector is enabled.
SIMULATE_PRIVATE_CRASH=false

# ==========================================
# SPRING / SECURITY
# ==========================================
SPRING_PROFILE=dev
JWT_KEY_ID=helphub-rs256-2026-01
JWT_ISSUER=helphub-identity
JWT_AUDIENCE=helphub-services
OTP_HMAC_KEY_BASE64=YOUR_EXISTING_OTP_SECRET

# ==========================================
# FRONTEND / EMAIL
# ==========================================
FRONTEND_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SECURE=false
MAIL_FROM=no-reply@helphub.local

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# RABBITMQ
# ==========================================
RABBITMQ_USER=helphub_admin
RABBITMQ_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
RABBITMQ_VHOST=helphub
RABBITMQ_VOLUME_NAME=helphub_rabbitmq_data

# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# MEDIA PRIVATE ACCESS GRANT
# ==========================================
# Temporary Cloudinary download URL lifetime.
# Allowed range: 15-300 seconds.
MEDIA_ACCESS_GRANT_TTL_SECONDS=120
