# PostgreSQL administrator
POSTGRES_ADMIN_USER=helphub_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_VOLUME_NAME=helphub_pgdata

# Identity Service
IDENTITY_DB_NAME=helphub_identity
IDENTITY_DB_USER=helphub_identity_app
IDENTITY_DB_PASSWORD=change_me_identity

# Support Service
SUPPORT_DB_NAME=helphub_support
SUPPORT_DB_USER=helphub_support_app
SUPPORT_DB_PASSWORD=change_me_support

# Media Service
MEDIA_DB_NAME=helphub_media
MEDIA_DB_USER=helphub_media_app
MEDIA_DB_PASSWORD=change_me_media

# SPRING / SECURITY
SPRING_PROFILE=dev
JWT_KEY_ID=helphub-rs256-2026-01
JWT_ISSUER=helphub-identity
JWT_AUDIENCE=helphub-services
OTP_HMAC_KEY_BASE64=YOUR_EXISTING_OTP_SECRET

# FRONTEND / EMAIL
FRONTEND_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SECURE=false
MAIL_FROM=no-reply@helphub.local

CORS_ALLOWED_ORIGINS=http://localhost:5173